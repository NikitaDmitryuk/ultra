# Canonical deployment policy; secrets belong only in .env.
INSTALL_SCHEMA_VERSION=2
SECRETS_ENV_FILE=.env
# Trusted public key for verifying signed GitHub release bundles.
ULTRA_RELEASE_MINISIGN_PUBLIC_KEY=REPLACE_WITH_TRUSTED_MINISIGN_PUBLIC_KEY
SSH_USER=root
BRIDGE_IP=192.0.2.10
BRIDGE_SSH_KEY=/secure/bridge_ed25519
PUBLIC_HOST=192.0.2.10
MAIN_EXIT_IP=192.0.2.20
MAIN_EXIT_SSH_KEY=/secure/exit_ed25519
REUSE_BRIDGE_SPEC=false
REALITY_DEST=origin.example.net:443
REALITY_SNI=origin.example.net
VLESS_PORT=24443
PRESET=steamlike
DATABASE_IP=192.0.2.40
DATABASE_SSH_KEY=/secure/database_ed25519
# Optional local custom-format pg_dump archive for a clean DB host.
# DATABASE_DUMP=/secure/database.dump
# Reinstalling a bridge with an existing DB: private saved spec from bridge/backup.
# DB_CREDENTIALS_FILE=/secure/previous-bridge-spec.json
DB_NAME=ultra_db
DB_USER=ultra
BOT_ENABLE=true
# Bootstrap provisions subscription and VPN DNS records; bot uses the subscription name.
BOT_DOMAIN=sync.example.com
BOT_PORT=8444
SUBSCRIPTION_DOMAIN=sync.example.com
VPN_DOMAIN=edge.example.com
ACME_EMAIL=operator@example.com
PUBLIC_XHTTP_PATH=/connect
DNS_PROVIDER=vultr
DNS_ZONE=example.com
DNS_TTL=300
DNS_SUBSCRIPTION_NAME=sync
DNS_VPN_NAME=edge
ULTRA_AUTOMATION_VERSION=v1.0.0
ULTRA_AUTOMATION_RELEASE_DIR=/srv/ultra-release-v1.0.0
ULTRA_AUTOMATION_AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT
ULTRA_AUTOMATION_BRIDGE_PROVIDER=provider-a
ULTRA_AUTOMATION_KNOWN_HOSTS_FILE=/secure/ultra-known-hosts
ULTRA_AUTOMATION_ADMIN_TELEGRAM_ID=REPLACE_ADMIN_TELEGRAM_ID
ULTRA_AUTOMATION_STATIC_NODES='[{"name":"primary","address":"192.0.2.20","provider":"provider-a","budget":{"monthly_bytes":1048576,"is_fallback":true}}]'
ULTRA_AUTOMATION_READINESS_TIMEOUT_SEC=900
