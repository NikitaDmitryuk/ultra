# Managed by ultra-install; independent subscription vhost.
server {
    listen 80;
    server_name {{ ultra_subscription_domain }};
    access_log off;
    error_log /var/log/nginx/ultra-subscription-error.log crit;
    location ^~ /.well-known/acme-challenge/ { root /var/www/ultra-acme; }
    location / { return 301 https://{{ ultra_subscription_domain }}$request_uri; }
}
server {
    listen 443 ssl http2;
    server_name {{ ultra_subscription_domain }};
    ssl_certificate /etc/letsencrypt/live/{{ ultra_subscription_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ ultra_subscription_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /var/log/nginx/ultra-subscription-error.log crit;
    location / {
        proxy_pass https://127.0.0.1:{{ ultra_bot_port }};
        proxy_ssl_server_name on;
        proxy_ssl_name {{ ultra_bot_domain }};
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 4;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host {{ ultra_subscription_domain }};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 40s;
        proxy_send_timeout 40s;
    }
}
