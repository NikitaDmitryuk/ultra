[Unit]
Description=Ultra independent replica transport
After=network-online.target
Wants=network-online.target
[Service]
User=root
UMask=0077
ExecStart=/usr/bin/ssh -F /dev/null -o BatchMode=yes -o StrictHostKeyChecking=yes -o UpdateHostKeys=no -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=5 -o ServerAliveCountMax=2 -o UserKnownHostsFile=/etc/ultra-replica-tunnels/{{ ultra_replica_slot }}.known_hosts -i /etc/ultra-replica-tunnels/{{ ultra_replica_slot }}.identity -N -R 127.0.0.1:15432:127.0.0.1:{{ ultra_replica_primary_port }} root@{{ ultra_replica_address }}
Restart=on-failure
RestartSec=5
KillMode=control-group
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
