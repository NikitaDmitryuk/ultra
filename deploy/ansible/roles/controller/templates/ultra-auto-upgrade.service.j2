[Unit]
Description=Ultra signed stable release checker
After=network-online.target ultra-ansible-controller.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/ultra-ansible/current/ultra-install auto-upgrade --policy /etc/ultra-ansible/auto-upgrade.json
TimeoutStartSec=45min
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
