[Unit]
Description=Ultra isolated experimental transport
After=network-online.target ultra-relay.service
[Service]
User=ultra-experimental
Group=ultra-experimental
ExecStart=/opt/ultra-experimental/ultra-relay -transport-spec /etc/ultra-experimental/spec.json
Restart=on-failure
RestartSec=5
MemoryMax=256M
CPUQuota=50%
TasksMax=64
LimitNOFILE=8192
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
[Install]
WantedBy=multi-user.target
