[Unit]
Description=Full ultra VPN path used by independent monitoring
After=network-online.target
Wants=network-online.target
[Service]
User=root
UMask=0077
ExecStart=/usr/local/bin/ultra-client -config /etc/ultra-recovery/probe.json -socks 127.0.0.1:10818 -http 127.0.0.1:10819
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=yes
[Install]
WantedBy=multi-user.target
