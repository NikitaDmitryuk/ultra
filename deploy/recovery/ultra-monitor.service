[Unit]
Description=Independent ultra health check and Telegram delivery
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/ultra-recovery/monitor.py --config /etc/ultra-recovery/monitor.json
TimeoutStartSec=50
PrivateTmp=yes
NoNewPrivileges=true
