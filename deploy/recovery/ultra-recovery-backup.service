[Unit]
Description=Encrypted ultra recovery generations
After=network-online.target
Wants=network-online.target

[Service]
ExecCondition=/opt/ultra-ansible/current/ultra-install deploy-operation background-ready
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/ultra-recovery/recovery.py capture --config /etc/ultra-recovery/backup.json
TimeoutStartSec=170
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=yes
