# Скопируйте в install.config в корне репозитория (install.config в .gitignore).
# make install применяет изменения на серверах; сначала проверьте plan и doctor.
# make relay-logs / make verify-relay — хосты и ключ из файла.
#
# Подставьте свои адреса, ключ, TLS target и URL проверки; example.* — placeholders.
# Это вход схемы 1 для установки или adopt. Полный шаблон схемы 2:
# deploy/install.config.v2.example; принятие runtime описано в docs/automation.md.
# Секреты и токены храните только в .env; этот файл не является shell-скриптом.

BRIDGE=203.0.113.10
EXIT=203.0.113.11
# Вторая exit VPS для failover (primary EXIT priority=100, backup EXIT2 priority=200).
EXIT2=203.0.113.12
SSH_USER=root
IDENTITY=/Users/you/.ssh/id_ed25519
PUBLIC_HOST=203.0.113.10

# Legacy REALITY inbound: замените цель на проверенный допустимый host:443.
# Эти параметры не задают домен основного XHTTP/TLS-входа (см. VPN_DOMAIN ниже).
REALITY_DEST=origin.example.net:443
REALITY_SNI=origin.example.net

# Шаблон HTTP для splithttp (bridge→exit).
PRESET=steamlike

# Маршрутизация на bridge при split_routing: ru_direct — direct для RU/private, остальное на exit;
# blocklist — только geosite_exit_tags на exit (как раньше).
ROUTING_MODE=ru_direct

VLESS_PORT=443
TUNNEL_PORT=8443
LOG_LEVEL=info
GENERATE_EXIT_TLS=y

# Переиспользовать ключи с bridge при переустановке (Reality, tunnel UUID, splithttp).
# Сохраняет идентификаторы; не означает принятие всего runtime без изменений.
# Для принятия runtime используйте adopt/apply --adopt-runtime (docs/automation.md).
# Для новой установки без существующего spec явно задайте n (по умолчанию y).
REUSE_BRIDGE_SPEC=y

# Транспортный протокол внутреннего туннеля bridge→exit.
# splithttp — XHTTP stream-up H2 (рекомендуется; замена gRPC в Xray 26). Значение по умолчанию.
# grpc      — устарело в Xray 26; только если splithttp блокируется промежуточными узлами.
TRANSPORT=splithttp

# VLESS flow для публичного REALITY inbound и клиентских URI (Xray 26).
# По умолчанию xtls-rprx-vision; не применяется к XHTTP. После изменения обновите подписку.
VLESS_FLOW=xtls-rprx-vision
# Отключить flow для legacy-клиентов (предупреждения Xray останутся):
# DISABLE_VLESS_FLOW=y

# При необходимости: DNS/IP для dial с bridge (если отличается от EXIT / EXIT2).
# EXIT_DIAL=exit.example.com
# EXIT2_DIAL=exit2.example.com
# EXIT2_PRIORITY=200
# EXIT2_NAME=backup

# Переопределение hostname/path сегмента splithttp (SAN self-signed и splithttp_tls под host).
# SPLITHTTP_HOST=
# SPLITHTTP_PATH=

# --- Несколько exit-нод (failover) ---
#
# При make install ultra-install ставит обе exit VPS (EXIT + EXIT2), генерирует tunnel UUID
# для каждой и кладёт exit_nodes.bootstrap.json на bridge рядом с spec.json.
# При первом старте bridge импортирует обе строки в PostgreSQL (exit_nodes).
# Управление после установки: Mini App → Настройки → Exit-ноды, или Admin API GET/POST /v1/exits.
#
# Добавить третью exit или заменить упавшую VPS позже:
#   1. Mini App → добавить exit (имя, address dial с bridge, port, priority)
#   2. make build-linux-amd64 build-install
#   3. ./ultra-install -exit-only -bridge $BRIDGE -exit NEW_EXIT_IP \
#        -tunnel-uuid '<UUID из ответа POST /v1/exits>' -identity $IDENTITY
#
# --- Проверка цепочки после установки (нужны локально xray, jq или python3) ---
# Если exit недоступен по SSH, ultra-install помечает его enabled=false в bootstrap/PostgreSQL.
# Установка завершится с ошибкой, только если не задеployed ни одна exit.
# Проверка использует локальный SOCKS клиента, а не публичный SOCKS listener relay.
# Недоступность exit нужно устранить; VERIFY_AFTER_INSTALL=n пропускает проверку цепочки.
VERIFY_AFTER_INSTALL=y
VERIFY_IP_URL=https://probe.example.net/plain-ip
VERIFY_SOCKS_PORT=10808
# VERIFY_USER_UUID=
# После первого GET по умолчанию вызывается split-routing (только зонд exit). Отключить: VERIFY_SPLIT_ROUTING=n.
# VERIFY_SPLIT_ROUTING=n
# VERIFY_PROBE_EXIT_URL=
# VERIFY_PROBE_EXIT_PLAIN_URL=   # укажите подконтрольную HTTPS-цель для проверки exit
VERIFY_FAIL_LOG_LINES=400

# Опционально: geosite-теги в blackhole (нужен тег в вашем geosite.dat), например реклама.
# GEOSITE_BLOCK_TAGS=category-ads-all
#
# Домены, которые должны оставаться на bridge direct. BOT_DOMAIN добавляется сюда автоматически
# при BOT_ENABLE=y, чтобы Mini App не уходила через active exit.
# DOMAIN_DIRECT=domain:example.com,domain:another.example.com

# --- Выходной IP (Cloudflare WARP на exit) ---
#
# Cloudflare WARP на exit-ноде: меняет IP выхода с датацентра на Cloudflare.
# Опционально устанавливается при WARP_ENABLE=y; не скрывает вход клиент→bridge.
# Cloudflare WARP, DNS и CDN — отдельные функции; CDN здесь не включается.
# WARP_ENABLE=y
# WARP_PORT=40000   # порт SOCKS5 (по умолчанию 40000)
#
# DNS over HTTPS (включён по умолчанию).
# Bridge использует Yandex DoH для .ru/.su и Cloudflare для остального.
# DOH_DISABLE=y   # раскомментируйте, чтобы использовать системный DNS

# --- Тонкая настройка протокола (все опции имеют рабочие значения по умолчанию) ---
#
# Профиль сетевых настроек для резервных профилей клиента: fast, balanced, stealth.
# Пусто = balanced. Название stealth не гарантирует обход блокировок оператора.
# Основной старый TCP+REALITY URI от этого не меняется.
# ANTI_CENSOR_PROFILE=balanced
#
# Дополнительный публичный порт на bridge для резервного VLESS+REALITY+XHTTP профиля.
# При включённых legacy listeners VLESS_PORT обслуживает TCP+REALITY.
# Это не основной HTTPS-вход: он задаётся через ingress/primary_xhttp.
# 0/пусто = не добавлять этот резервный listener; firewall контролирует развёртывание.
# PUBLIC_XHTTP_PORT=8445
#
# Фрагментация TLS ClientHello bridge→exit по умолчанию выключена.
# FRAGMENT_DISABLE=y явно отключает её; n не включает фрагментацию автоматически.
# Это не настройка ClientHello клиента Happ на участке клиент→bridge.
# FRAGMENT_DISABLE=y
#
# XHTTP padding (TRANSPORT=splithttp), положительный диапазон min-max байт.
# Пустое значение и старые нулевые диапазоны используют стандарт ядра 100-1000.
# Не сужайте совместимый диапазон работающего listener без проверки клиентов.
# SPLITHTTP_PADDING=100-1000
#
# Максимальный размер тела одного POST-запроса в туннеле, КБ
# (только packet-up; на стандартный stream-up не влияет; 0 = умолчание Xray ≈1 МБ):
# SPLITHTTP_MAX_CHUNK_KB=0
#
# Первый fingerprint используется только при пустом reality.fingerprint; по умолчанию chrome.
# Перезапуск сервера не ротирует ClientHello клиентов. XHTTP/TLS fingerprint задаётся
# отдельно в ingress/runtime: этот список не меняет уже принятые Firefox-профили.
# REALITY_FINGERPRINTS=firefox

# --- Telegram Mini App (ultra-bot) ---
# Чтобы развернуть Telegram-бота с веб-интерфейсом администратора:
#   1. Создайте бота через https://t.me/BotFather и получите токен.
#   2. ОБЯЗАТЕЛЬНО: скопируйте .env.sample → .env и вставьте TELEGRAM_BOT_TOKEN
#      (make install завершится ошибкой при BOT_ENABLE=y без .env).
#   3. Укажите домен, на котором будет доступна Mini App (FQDN; нужен DNS A-запись на bridge).
#      A-запись → IP bridge (BRIDGE), не на exit — иначе Mini App: ERR_TIMED_OUT в Telegram.
#      Проверка: make verify-miniapp
#   4. Установите BOT_ENABLE=y и запустите make install.
#
# BOT_ENABLE=y
# BOT_DOMAIN=admin.example.com   # FQDN; A-запись на bridge
# BOT_PORT=8444                       # HTTPS порт Mini App (по умолчанию 8444)
#
# Telegram API (long polling, алерты): ultra-bot использует ULTRA_BOT_TELEGRAM_SOCKS5
# (127.0.0.1:10809 по умолчанию) — локальный SOCKS inbound в bridge Xray → active exit.
# TLS-сертификат получается автоматически через certbot (HTTP-01) при make install.
# Домен должен быть под вашим управлением и разрешать автоматическое обновление DNS.

# --- База данных PostgreSQL ---
# DB_ENABLE=y запускает автоматическую установку и настройку PostgreSQL:
#   — primary на DB_HOST (по умолчанию: BRIDGE)
#   — streaming replica на DB_REPLICA (по умолчанию: EXIT)
# Хранит пользователей, ключи, статистику трафика (месячный расход).
# Заделы для Telegram-бота: планы, подписки, платежи, сессии, очередь уведомлений.
#
DB_ENABLE=y
# DB_HOST=          # хост для PostgreSQL primary; пусто = BRIDGE (база на bridge-хосте)
# DB_REPLICA=       # хост для streaming replica;  пусто = EXIT  (реплика на exit-хосте)
# DB_SSH_USER=      # SSH-пользователь для DB-хостов; пусто = SSH_USER
# DB_NAME=ultra_db
# DB_USER=ultra

# --- Прочее (по умолчанию можно не трогать) ---
# Таймаут SSH при make install / ultra-install / relay-logs (секунды; по умолчанию 10):
# ULTRA_SSH_CONNECT_TIMEOUT=10
# Geo на bridge при установке (скачивание с GitHub): по умолчанию выполняется по SSH.
# SKIP_GEO_DOWNLOAD=y — не качать (положите geoip.dat и geosite.dat сами в geo_assets_dir).
# Синоним устаревшего имени: SKIP_RUNETFREEDOM_GEO=y
# GEO_RELEASE_TAG=REPLACE_RELEASE_TAG — зафиксировать тег релиза вместо latest.

# Жёсткая проверка SSH host key (нужен заранее заполненный known_hosts):
# ULTRA_INSTALL_SSH_STRICT_HOST_KEY=yes

# --- Постоянные домены подписки и XHTTP/TLS ---
# BOT_DOMAIN — TLS identity backend бота; после cutover может оставаться legacy.
# SUBSCRIPTION_DOMAIN — публичный origin подписок/Mini App; VPN_DOMAIN — XHTTP.
# Не заменяйте BOT_DOMAIN автоматически: Nginx проверяет сертификат backend по этому имени.
# Изменение опубликованных доменов: ultra-install domain-cutover, см. docs/subscription-ingress.md.
# SUBSCRIPTION_DOMAIN=sync.example.com
# VPN_DOMAIN=edge.example.com
# PUBLIC_HOST=edge.example.com
# ACME_EMAIL=operator@example.com
# PUBLIC_XHTTP_PATH=/connect
# SUBSCRIPTION_INGRESS_MODE=direct
# DNS_PROVIDER=vultr
# DNS_ZONE=example.com
# DNS_TTL=300
# DNS_SUBSCRIPTION_NAME=sync
# DNS_VPN_NAME=edge
# Автоматизация DNS схемы 2 поддерживает Vultr; зону и делегирование NS создают заранее.
# Cloudflare CDN не требуется. Смена DNS-провайдера требует поддержки в автоматизации.
#
# Origin для make verify-miniapp; при постоянном домене согласуйте с SUBSCRIPTION_DOMAIN.
# Пусто = прежняя схема https://BOT_DOMAIN:BOT_PORT; не меняет runtime public URL само по себе.
# BOT_PUBLIC_URL=https://sync.example.com
BOT_PUBLIC_URL=
# Пусто для direct; адрес отдельного узла только при SUBSCRIPTION_INGRESS_MODE=forward.
# При direct автоматизация игнорирует этот адрес, но verify-miniapp использует его как ожидаемый IP.
BOT_INGRESS_IP=

# Дополнительный явный backup inventory для INSTALL_SCHEMA_VERSION=2.
# JSON-массивы абсолютных путей на bridge; отсутствие или [] не добавляет путей.
# Старый inventory автоматически не переносится: перечислите только нужные пути.
# ULTRA_AUTOMATION_STATE_PATHS='["/etc/owned-service/config"]'
# ULTRA_AUTOMATION_ARTIFACT_PATHS='["/opt/owned-service/restore.py"]'
